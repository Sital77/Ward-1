rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🔒 Security: Only authenticated ward staff can access system records
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (request.auth.token.admin == true || request.auth.uid == 'admin' || request.auth.token.email == 'adhikarishrital@gmail.com');
    }

    // Ward users collection: Only authenticated users can read/write their own info
    match /ward_users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // System Backups: Only authenticated staff can create/read backups; deletion requires admin
    match /system_backups/{backupId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Deleted Records Log / Recycle Bin: Viewing and permanent purge restricted to admin; staff can log soft-delete
    match /deleted_records_log/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Nissa Records (Squatters, Dalit, Landless records): Authenticated staff read-only, admin write
    match /nissa_records/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Recommendation Templates (Letter layouts)
    match /sifarish_templates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // All Sifarish Recommendation Collections
    match /{collectionName}/{docId} {
      // Allow read & write only if authenticated
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      
      // Hard delete restricted to admin
      allow delete: if isAdmin();
    }
  }
}
